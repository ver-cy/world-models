{
  "format": "vercy-allocation-validation/v1",
  "requirements": {
    "modelIdMustBeNull": true,
    "registryIdMustBeNull": true,
    "allocationState": "unassigned",
    "minimumInvariants": 8,
    "minimumReferences": 3,
    "minimumFixtures": 3,
    "requiresPositiveAndNegativeFixtures": true,
    "requiresStableIdentityStatement": true,
    "requiresIndependentLifecycle": false,
    "requiresFixtureFields": [
      "id",
      "target",
      "kind",
      "input",
      "expect",
      "violates",
      "closesDefect"
    ],
    "requiresExpectedCodeOnNegative": true,
    "forbidsUnverifiedReferenceTargets": true,
    "requiresCompletionDependencies": true,
    "requiresHolds": true,
    "requiresCanonicalPublishableFalse": true,
    "errorCodeRegistry": "candidate-allocation-offline-shared/codes.json",
    "requiresIndependentLifecycleAxes": true
  }
}
