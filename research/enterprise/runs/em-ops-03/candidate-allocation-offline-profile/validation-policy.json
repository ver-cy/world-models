{
  "format": "vercy-allocation-validation/v1",
  "requirements": {
    "newRuntimeIdMustBeFalse": true,
    "requiresCanonicalPublishableFalse": true,
    "requiresProfiledRelations": true,
    "requiresResolvedDisagreements": true,
    "requiresReusedCandidates": true,
    "requiresAlignedViewsSeparateFromBases": true,
    "requiresProjectionsSeparateFromBases": true,
    "requiresCompletionDependencies": true,
    "requiresHolds": true,
    "minimumConstraints": 10,
    "minimumFixtures": 3,
    "requiresPositiveAndNegativeFixtures": true
  }
}
