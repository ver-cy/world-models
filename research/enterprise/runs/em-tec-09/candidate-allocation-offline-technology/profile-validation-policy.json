{
  "format": "vercy-allocation-validation/v1",
  "requirements": {
    "newRuntimeIdMustBeFalse": true,
    "canonicalPublishableMustBeFalse": true,
    "minimumConstraints": 10,
    "minimumBases": 1,
    "minimumFixtures": 10,
    "minimumPositiveFixtures": 3,
    "minimumNegativeFixtures": 3,
    "requiresProfiledBase": true,
    "requiresNonOwnershipStatement": true,
    "requiredFixtureFields": [
      "id",
      "target",
      "kind",
      "input",
      "expect",
      "violates",
      "closesDefect"
    ],
    "requiredNegativeFixtureFields": [
      "expectedCode"
    ],
    "referenceTargetsMustBeEvidenced": true
  }
}
