{
  "format": "vercy-allocation-validation/v1",
  "requirements": {
    "modelIdMustBeNull": true,
    "registryIdMustBeNull": true,
    "allocationState": "unassigned",
    "minimumInvariants": 8,
    "minimumReferences": 3,
    "minimumFixtures": 4,
    "requiresPositiveAndNegativeFixtures": true,
    "requiresStableIdentityStatement": true,
    "requiresIndependentLifecycle": true,
    "admittedReferenceTargets": [
      "WM-KNW-011",
      "WM-ACT-030",
      "WM-KNW-010",
      "WM-ACT-024",
      "WM-REC-010",
      "WM-ACT-001",
      "WM-ACT-003"
    ],
    "unadmittedReferenceTargetsMustBeNull": true,
    "canonicalPublishableMustBeFalse": true,
    "requiresNonEmptyHolds": true,
    "negativeFixturesRequireExpectedCode": true,
    "minimumPositiveFixtures": 4,
    "minimumNegativeFixtures": 4,
    "forbidsPublicationReadinessClaim": true,
    "requiresContainedObjectIdentity": true,
    "requiresVersionCouplingStatement": true,
    "requiresDigestSpecification": true,
    "requiresImmutabilityCheckOnReleasedStates": true
  }
}
