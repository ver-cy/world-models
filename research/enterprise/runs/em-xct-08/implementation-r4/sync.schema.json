          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "previousDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9:._/-]*$(?![\\s\\S])"
        },
        "recordedAt": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "command": {
          "oneOf": [
            {
              "$ref": "#/$defs/Command"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
