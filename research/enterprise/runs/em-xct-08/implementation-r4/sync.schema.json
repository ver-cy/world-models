                }
              }
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/JournalResult"
        },
        "outcomeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    }
