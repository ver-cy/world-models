{
  "format": "vercy-allocation-validation/v1",
  "requirements": {
    "modelIdMustBeNull": true,
    "registryIdMustBeNull": true,
    "allocationState": "unassigned",
    "minimumInvariants": 14,
    "minimumReferences": 3,
    "minimumFixtures": 24,
    "requiresPositiveAndNegativeFixtures": true,
    "requiresStableIdentityStatement": true,
    "requiresIndependentLifecycle": true,
    "minimumPositiveFixtures": 3,
    "minimumNegativeFixtures": 4,
    "requiresNegativeExpectedCode": true,
    "requiresDefectLinkage": true,
    "forbidsRootsOutsideSettledSet": [
      "Inventory Boundary",
      "Emission Factor Registry",
      "Environmental Impact Calculation Run"
    ],
    "forbidsActivityDataRoot": true,
    "requiresClosedEnumerations": true,
    "requiresUnallocatedDependencyDeclaration": true,
    "requiresReferenceEdgeState": true
  }
}
