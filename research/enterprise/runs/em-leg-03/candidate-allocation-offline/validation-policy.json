{
  "format": "vercy-allocation-validation/v1",
  "requirements": {
    "modelIdMustBeNull": true,
    "registryIdMustBeNull": true,
    "allocationState": "unassigned-pending-reuse-test",
    "minimumInvariants": 8,
    "minimumReferences": 3,
    "minimumFixtures": 20,
    "requiresPositiveAndNegativeFixtures": true,
    "requiresStableIdentityStatement": true,
    "requiresIndependentLifecycle": true,
    "decision": "REUSE-TEST-PENDING",
    "requiresPinnedInstants": true,
    "requiresSingleExpectedOutcome": true
  }
}
