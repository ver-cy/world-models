      "purpose": "Contract exposure cites endpoint; endpoint stores no mirrored binding."
    }
  ],
  "invariants": [
    {
      "id": "INV-SFT018-01",
      "rule": "Endpoint identity is independent of IP, host, URL, port, protocol, runtime resource, and interface revision."
    },
    {
      "id": "INV-SFT018-02",
      "rule": "Dependent facts are unique by natural key; local handles never replace parent-scoped identity."
    },
    {
      "id": "INV-SFT018-03",
      "rule": "Address reassignment never merges endpoint identity; retired endpoints retain tombstones and acyclic successor evidence."
    },
    {
      "id": "INV-SFT018-04",
      "rule": "Concurrent address bindings require explicit distinct scope or environment."
    },
    {
      "id": "INV-SFT018-05",
      "rule": "Connectivity is directional unless explicitly bidirectional and never proves observed traffic or current reachability."
    },
    {
      "id": "INV-SFT018-06",
      "rule": "Exposure states audience, access mode, authority, policy, scope, and effective interval."
    },
    {
      "id": "INV-SFT018-07",
      "rule": "Credentials, secrets, tokens and private keys are never stored."
    },
    {
      "id": "INV-SFT018-08",
      "rule": "Runtime replacement preserves endpoint identity when logical exposure is continuous."
    },
    {
      "id": "INV-SFT018-09",
      "rule": "Historical resolution uses valid time and record time; corrections append and supersede rather than edit."
    },
    {
      "id": "INV-SFT018-10",
      "rule": "Intervals are half-open UTC [from,to); to is greater than from; null to is open-ended."
    },
    {
      "id": "INV-SFT018-11",
      "rule": "A complete connectivity or exposure inventory inherits the strictest member classification and policy ceiling."
    },
    {
      "id": "INV-SFT018-12",
      "rule": "One authority governs an address namespace at a time; conflicts are recorded and not silently resolved."
    },
    {
      "id": "INV-SFT018-13",
      "rule": "Declared and observed network facts remain separate even when telemetry contradicts a declaration."
    }
  ],
  "holds": [
    "Registry confirmation of WM-SFT-002, WM-SFT-010 and WM-SFT-017 is required before advancement.",
    "Environment, owner, authority, policy, scope and zone reference targets must be resolved from existing registry entries before publication.",
    "Canonical publication and live verification are held; no new runtime ID."
  ]
