{
  "format": "vercy-world-model-candidate/v1",
  "contourId": "EM-TEC-03",
  "modelId": "WM-SFT-018",
  "registryId": "vr.wm-sft-018",
  "name": "Network / Endpoint",
  "version": "0.1.0-candidate.2",
  "entryKind": "network-endpoint-aggregate",
  "status": "research-candidate",
  "canonicalPublishable": false,
  "purpose": "Represent stable logical endpoint identity plus append-only effective-dated address, connectivity, exposure and zone assertions without owning software, runtime, interface, traffic observation or secret identity.",
  "boundary": {
    "owns": [
      "logical endpoint identity and lifecycle",
      "effective-dated address bindings",
      "directional connectivity declarations",
      "bounded exposure assertions",
      "zone membership and tombstone history"
    ],
    "delegates": [
      "software system identity to WM-SFT-002",
      "runtime identity to WM-SFT-010",
      "contract exposure to WM-SFT-003",
      "observed telemetry to WM-SFT-017"
    ],
    "excludes": [
      "credentials secrets tokens and private keys",
      "software or runtime mastership",
      "contract and schema semantics",
      "observed traffic or reachability",
      "address as eternal identity"
    ]
  },
  "temporal": {
    "interval": "half-open [from,to)",
    "timeBasis": "UTC millisecond precision",
    "openEnd": "null to",
    "recordTime": "recordedAt is append-only; corrections use supersedesLocalHandle"
  },
