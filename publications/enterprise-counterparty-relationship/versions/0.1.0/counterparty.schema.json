{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ver.cy/models/enterprise-counterparty-relationship/versions/0.1.0/counterparty.schema.json",
  "title": "Enterprise Counterparty Relationship Profile records",
  "oneOf": [
    {
      "$ref": "#/$defs/CounterpartyRelationshipSet"
    },
    {
      "$ref": "#/$defs/CommercialRoleBinding"
    },
    {
      "$ref": "#/$defs/AccountScopeBinding"
    },
    {
      "$ref": "#/$defs/ContactAssignment"
    },
    {
      "$ref": "#/$defs/SegmentationAssertion"
    }
  ],
  "$defs": {
    "Base": {
      "type": "object",
      "required": [
        "id",
        "validFrom"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CounterpartyRelationshipSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "setId",
        "partyRef",
        "observerDimensionRef",
        "createdAt"
      ],
      "properties": {
        "kind": {
          "const": "CounterpartyRelationshipSet"
        },
        "setId": {
          "type": "string",
          "minLength": 1
        },
        "partyRef": {
          "type": "string",
          "minLength": 1
        },
        "observerDimensionRef": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "displayCache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoritative",
            "values"
          ],
          "properties": {
            "authoritative": {
              "const": false
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "CommercialRoleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bindingId",
        "setRef",
        "role",
        "upstreamModel",
        "upstreamRecordRef",
        "upstreamVersion",
        "upstreamDigest",
        "sourceMasterRef",
        "validFrom"
      ],
      "properties": {
        "kind": {
          "const": "CommercialRoleBinding"
        },
        "bindingId": {
          "type": "string",
          "minLength": 1
        },
        "setRef": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "customer",
            "supplier",
            "partner"
          ]
        },
        "upstreamModel": {
          "enum": [
            "WM-ORG-014",
            "WM-ORG-015"
          ]
        },
        "upstreamRecordRef": {
          "type": "string",
          "minLength": 1
        },
        "upstreamVersion": {
          "type": "string",
          "minLength": 1
        },
        "upstreamDigest": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
        },
        "sourceMasterRef": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": "string",
          "format": "date-time"
        },
        "supersededByRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AccountScopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scopeBindingId",
        "setRef",
        "scopeKind",
        "targetRef",
        "sourceMasterRef",
        "validFrom"
      ],
      "properties": {
        "kind": {
          "const": "AccountScopeBinding"
        },
        "scopeBindingId": {
          "type": "string",
          "minLength": 1
        },
        "setRef": {
          "type": "string",
          "minLength": 1
        },
        "scopeKind": {
          "enum": [
            "seller",
            "buyer",
            "legal-entity",
            "group"
          ]
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceMasterRef": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ContactAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "assignmentId",
        "setRef",
        "endpointRef",
        "endpointModel",
        "purpose",
        "roleBindingRef",
        "scopeBindingRef",
        "validFrom"
      ],
      "properties": {
        "kind": {
          "const": "ContactAssignment"
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1
        },
        "setRef": {
          "type": "string",
          "minLength": 1
        },
        "endpointRef": {
          "type": "string",
          "minLength": 1
        },
        "endpointModel": {
          "const": "WM-PER-010"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "roleBindingRef": {
          "type": "string",
          "minLength": 1
        },
        "scopeBindingRef": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SegmentationAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "assertionId",
        "setRef",
        "code",
        "schemeRef",
        "schemeVersion",
        "sourceRef",
        "method",
        "assertedAt",
        "validFrom"
      ],
      "properties": {
        "kind": {
          "const": "SegmentationAssertion"
        },
        "assertionId": {
          "type": "string",
          "minLength": 1
        },
        "setRef": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "schemeRef": {
          "type": "string",
          "minLength": 1
        },
        "schemeVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "declared",
            "derived",
            "purchased",
            "observed"
          ]
        },
        "assertedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validTo": {
          "type": "string",
          "format": "date-time"
        },
        "supersedesRef": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
