{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "id",
    "revision",
    "profile",
    "subject_ref",
    "governing_context",
    "period",
    "state",
    "purpose",
    "scale_versions",
    "objectives",
    "evidence",
    "assessments",
    "calibrations",
    "appeals",
    "recognition",
    "disclosures",
    "history",
    "policy",
    "program_ref"
  ],
  "properties": {
    "format": {
      "const": "vercy-performance-case-example"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "enum": [
        "employee",
        "contractor",
        "founder"
      ]
    },
    "subject_ref": {
      "type": "string",
      "format": "uri"
    },
    "governing_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "owner_org_ref",
        "authority_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "employment",
            "contract",
            "founder-mandate"
          ]
        },
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "owner_org_ref": {
          "type": "string",
          "format": "uri"
        },
        "authority_ref": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "state": {
      "enum": [
        "draft",
        "agreed",
        "evidence-open",
        "assessment-open",
        "issued",
        "disputed",
        "corrected",
        "closed",
        "retired"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scale_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "anchors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "assignment_ref",
          "success_criterion",
          "unit_of_analysis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "assignment_ref": {
            "type": "string",
            "format": "uri"
          },
          "success_criterion": {
            "type": "string",
            "minLength": 1
          },
          "unit_of_analysis": {
            "enum": [
              "person",
              "team",
              "system"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_ref",
          "method",
          "observed_at",
          "recorded_at",
          "unit_of_analysis",
          "kind",
          "purpose",
          "context_ref",
          "use_state",
          "reason",
          "attributions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "source_ref": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "unit_of_analysis": {
            "enum": [
              "person",
              "team",
              "system",
              "artifact"
            ]
          },
          "kind": {
            "enum": [
              "work-product",
              "attestation",
              "self-report",
              "activity-count",
              "surveillance-proxy"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "context_ref": {
            "type": "string",
            "format": "uri"
          },
          "use_state": {
            "enum": [
              "admitted",
              "contested",
              "excluded"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "attributions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_ref",
                "context_ref",
                "role",
                "share",
                "basis",
                "status"
              ],
              "properties": {
                "subject_ref": {
                  "type": "string",
                  "format": "uri"
                },
                "context_ref": {
                  "type": "string",
                  "format": "uri"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "asserted",
                    "attested",
                    "disputed",
                    "corrected"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "author_ref",
              "actor_kind",
              "narrative",
              "evidence_refs",
              "scale_ref",
              "scale_version",
              "rating",
              "issued_at",
              "status",
              "supersedes",
              "decision_effect",
              "known_conflict",
              "valid_at",
              "recorded_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uri"
              },
              "author_ref": {
                "type": "string",
                "format": "uri"
              },
              "actor_kind": {
                "enum": [
                  "human",
                  "agent"
                ]
              },
              "narrative": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "scale_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scale_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rating": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "issued_at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "draft",
                  "issued",
                  "superseded"
                ]
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "decision_effect": {
                "const": "review-only"
              },
              "known_conflict": {
                "type": "boolean"
              },
              "valid_at": {
                "type": "string",
                "format": "date-time"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "supersedes",
              "issued_at",
              "valid_at",
              "recorded_at",
              "redaction"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uri"
              },
              "status": {
                "const": "superseded"
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "issued_at": {
                "type": "string",
                "format": "date-time"
              },
              "valid_at": {
                "type": "string",
                "format": "date-time"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "redaction": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "policy_ref",
                  "authority_ref",
                  "recorded_at",
                  "reason"
                ],
                "properties": {
                  "policy_ref": {
                    "type": "string",
                    "format": "uri"
                  },
                  "authority_ref": {
                    "type": "string",
                    "format": "uri"
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "calibrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "before_assessment_ref",
          "after_assessment_ref",
          "panel_ref",
          "reason",
          "recorded_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "before_assessment_ref": {
            "type": "string",
            "format": "uri"
          },
          "after_assessment_ref": {
            "type": "string",
            "format": "uri"
          },
          "panel_ref": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "appeals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assessment_ref",
          "kind",
          "statement",
          "status",
          "authority_ref",
          "correction_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "assessment_ref": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "enum": [
              "fact-correction",
              "attribution-correction",
              "opinion-contest",
              "process-contest",
              "proxy-exclusion"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "accepted",
              "rejected"
            ]
          },
          "authority_ref": {
            "type": "string",
            "format": "uri"
          },
          "correction_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "recognition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "basis_ref",
          "kind",
          "changes_rating"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "basis_ref": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "changes_rating": {
            "const": false
          }
        }
      }
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "canonical_subject_ref",
          "purpose",
          "recipient_ref",
          "field_paths",
          "authorization_ref",
          "expires_at",
          "source_owner_ref",
          "source_revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uri"
          },
          "canonical_subject_ref": {
            "type": "string",
            "format": "uri"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "recipient_ref": {
            "type": "string",
            "format": "uri"
          },
          "field_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authorization_ref": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_owner_ref": {
            "type": "string",
            "format": "uri"
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "description": "This reference profile always rejects omission of applicable dispute context. Disclosure exceptions are out of scope; records are not permission to transmit."
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "recorded_at",
          "valid_at",
          "actor_ref",
          "reason",
          "previous_revision"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_ref": {
            "type": "string",
            "format": "uri"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "previous_revision": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_policy_ref",
        "permissions_policy_ref",
        "automatic_employment_decisions",
        "portable_person_score"
      ],
      "properties": {
        "retention_policy_ref": {
          "type": "string",
          "format": "uri"
        },
        "permissions_policy_ref": {
          "type": "string",
          "format": "uri"
        },
        "automatic_employment_decisions": {
          "const": false
        },
        "portable_person_score": {
          "const": false
        }
      }
    },
    "program_ref": {
      "type": "string",
      "format": "uri"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ver.cy/models/wm-org-017-performance-objective-review/instance.schema.json",
  "title": "Performance case companion example contract",
  "description": "A bounded executable reference profile, not a universal HRIS schema or a native Vercy Dimension storage binding. Review policy and jurisdictional holds apply."
}
